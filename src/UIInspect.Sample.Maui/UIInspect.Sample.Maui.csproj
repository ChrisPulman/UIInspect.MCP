<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>UIInspect.Sample.Maui</AssemblyName>
    <RootNamespace>UIInspect.Sample.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <UseWinUI>true</UseWinUI>
    <SingleProject>true</SingleProject>
    <EnableDefaultMauiItems>true</EnableDefaultMauiItems>
    <ApplicationTitle>UIInspect MAUI Sample</ApplicationTitle>
    <ApplicationId>com.chrispulman.uiinspect.sample.maui</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <Description>Deterministic .NET MAUI Windows UI Automation fixture for UIInspect MCP.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <MauiXaml Remove="Platforms\Windows\App.xaml" />
  </ItemGroup>
</Project>
