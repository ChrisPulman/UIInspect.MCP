<Window
    x:Class="UIInspect.Sample.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="UIInspect WinUI Sample">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" Spacing="8">
            <TextBlock
                FontSize="20"
                FontWeight="Bold"
                Text="UIInspect semantic action fixture" />

            <Border
                Padding="12"
                AutomationProperties.AutomationId="ControlsGroup"
                AutomationProperties.Name="Controls">
                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="Controls" />
                    <StackPanel
                        x:Name="ActionsPanel"
                        AutomationProperties.AutomationId="ActionsPanel"
                        AutomationProperties.Name="Actions panel"
                        Spacing="8">
                        <Button
                            Padding="8"
                            AutomationProperties.AutomationId="InvokeButton"
                            AutomationProperties.Name="Invoke action"
                            Click="InvokeButton_Click"
                            Content="Invoke" />

                        <Button
                            Padding="8"
                            AutomationProperties.AutomationId="DisabledButton"
                            Content="Disabled"
                            IsEnabled="False" />

                        <Button
                            x:Name="TransientTarget"
                            Padding="8"
                            AutomationProperties.AutomationId="TransientTarget"
                            Content="Transient target" />

                        <Button
                            Padding="8"
                            AutomationProperties.AutomationId="RemoveTransientButton"
                            Click="RemoveTransientButton_Click"
                            Content="Remove transient target" />

                        <TextBox
                            Padding="6"
                            AutomationProperties.AutomationId="ValueTextBox"
                            AutomationProperties.Name="Editable value"
                            Text="initial"
                            TextChanged="ValueTextBox_TextChanged" />

                        <PasswordBox
                            Padding="6"
                            AutomationProperties.AutomationId="PasswordBox"
                            AutomationProperties.Name="Sensitive password"
                            Password="not-returned" />

                        <ComboBox
                            Padding="6"
                            AutomationProperties.AutomationId="ColorComboBox"
                            AutomationProperties.Name="Color selection"
                            SelectedIndex="0"
                            SelectionChanged="ColorComboBox_SelectionChanged">
                            <ComboBoxItem AutomationProperties.AutomationId="RedItem" Content="Red" />
                            <ComboBoxItem AutomationProperties.AutomationId="GreenItem" Content="Green" />
                            <ComboBoxItem AutomationProperties.AutomationId="BlueItem" Content="Blue" />
                        </ComboBox>

                        <CheckBox
                            AutomationProperties.AutomationId="EnabledCheckBox"
                            AutomationProperties.Name="Enabled toggle"
                            Checked="EnabledCheckBox_Changed"
                            Content="Enabled"
                            IsChecked="True"
                            Unchecked="EnabledCheckBox_Changed" />

                        <StackPanel
                            AutomationProperties.AutomationId="NavigationTree"
                            AutomationProperties.Name="Navigation tree">
                            <Expander
                                AutomationProperties.AutomationId="RootNode"
                                AutomationProperties.Name="Root"
                                Header="Root"
                                IsExpanded="True">
                                <Expander
                                    AutomationProperties.AutomationId="ChildNode"
                                    AutomationProperties.Name="Child"
                                    Collapsed="ChildNode_Collapsed"
                                    Expanding="ChildNode_Expanding"
                                    Header="Child">
                                    <TextBlock
                                        AutomationProperties.AutomationId="LeafNode"
                                        Text="Leaf" />
                                </Expander>
                            </Expander>
                        </StackPanel>

                        <TextBox
                            Padding="6"
                            AutomationProperties.AutomationId="KeyboardTextBox"
                            AutomationProperties.Name="Keyboard target"
                            KeyDown="KeyboardTextBox_KeyDown"
                            Text="focus me" />

                        <TextBlock
                            x:Name="KeyStatusText"
                            AutomationProperties.AutomationId="KeyStatusText"
                            Text="key:none" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBox
                x:Name="ResultText"
                Padding="8"
                AutomationProperties.AutomationId="ResultText"
                AutomationProperties.Name="Last action result"
                IsReadOnly="True"
                Text="ready" />
        </StackPanel>
    </ScrollViewer>
</Window>
