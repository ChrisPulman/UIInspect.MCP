<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>UIInspect.MCP.Server</AssemblyName>
    <RootNamespace>UIInspect.MCP.Server</RootNamespace>
    <PackageId>UIInspect.MCP.Server</PackageId>
    <Title>UIInspect MCP Server</Title>
    <Description>Consent-gated semantic Windows UI Automation MCP server using UIA3 and FlaUI.</Description>
    <PackageTags>MCP;Model Context Protocol;UI Automation;UIA3;FlaUI;WPF;WinUI;WinForms;Avalonia;MAUI</PackageTags>
    <PackAsTool>true</PackAsTool>
    <PackageType>McpServer</PackageType>
    <ToolCommandName>uiinspect-mcp</ToolCommandName>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AssetTargetFallback>$(AssetTargetFallback);net8.0-windows7.0</AssetTargetFallback>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UIInspect.MCP.Core\UIInspect.MCP.Core.csproj" />
    <ProjectReference Include="..\UIInspect.MCP.Windows\UIInspect.MCP.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" Link="README.md" />
    <None Include="..\..\.mcp\server.json" Pack="true" PackagePath=".mcp\" Link=".mcp\server.json" />
    <None Include="..\..\skills\uiinspect\**\*.*"
          Pack="true"
          PackagePath="skills\uiinspect\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          LinkBase="skills\uiinspect" />
    <None Include="..\..\images\GitHubLogo.png" Pack="true" PackagePath="images\" Link="images\GitHubLogo.png" />
    <None Include="..\..\images\ReadmeHero.png" Pack="true" PackagePath="images\" Link="images\ReadmeHero.png" />
    <None Include="..\..\docs\mvp-design.md" Pack="true" PackagePath="docs\" Link="docs\mvp-design.md" />
    <None Include="..\..\docs\security.md" Pack="true" PackagePath="docs\" Link="docs\security.md" />
  </ItemGroup>
</Project>
